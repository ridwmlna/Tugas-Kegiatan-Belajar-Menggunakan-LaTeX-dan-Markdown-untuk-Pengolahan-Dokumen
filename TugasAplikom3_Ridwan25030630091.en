% menghitungnya langsung.)
>M &= [1,a;b,2]; $M
 %image% TugasApkom3_Ridwan25030630091-036.png
% // latex: \begin{pmatrix}1 & a \\ b & 2 \\ \end{pmatrix}
>$&det(M-x*ident(2)), $&solve(%,x)
 %image% TugasApkom3_Ridwan25030630091-037.png
