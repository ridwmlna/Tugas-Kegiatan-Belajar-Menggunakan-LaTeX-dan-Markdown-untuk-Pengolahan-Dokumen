% Pusat lingkaran oskulasinya di (-1/2, 5/4). Lingkaran biru menyinggung
% parabola persis di puncaknya.
% 
% Versi implisit untuk y = x^2 (F(x,y) = x^2 - y = 0):
% 
% latex: \kappa=\frac{F_y^2F_{xx}-2F_xF_yF_{xy}+F_x^2F_{yy}}{(F_x^2+F_y^2)^{3/2}}
% %image% TugasAplikom6_Ridwan25030630091-114.png
% // latex: \kappa=\frac{F_y^2F_{xx}-2F_xF_yF_{xy}+F_x^2F_{yy}}{(F_x^2+F_y^2)^{3/2}}
>Fi &= x^2-y

                                 2
                                x  - y

>Fx &= diff(Fi,x); Fy &= diff(Fi,y); Fxx &= diff(Fi,x,2); Fyy &= diff(Fi,y,2); Fxy &= diff(diff(Fi,x),y);
>kap &= (Fy^2*Fxx-2*Fx*Fy*Fxy+Fx^2*Fyy)/(Fx^2+Fy^2)^(3/2); $kap
 %image% TugasAplikom6_Ridwan25030630091-115.png
