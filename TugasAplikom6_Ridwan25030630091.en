% 
% Soal 5:
%% panjang kurva y = x^2 pada [0,1].
% 
% latex: S=\int_0^1\sqrt{1+(2x)^2}\,dx
% %image% TugasAplikom6_Ridwan25030630091-091.png
% // latex: S=\int_0^1\sqrt{1+(2x)^2}\,dx
>$showev('integrate(sqrt(1+diff(x^2,x)^2),x,0,1))
 %image% TugasAplikom6_Ridwan25030630091-092.png
% // latex: \int_{0}^{1}{\sqrt{4\,x^2+1}\;dx}=\frac{{\rm asinh}\; 2+2\,\sqrt{5}  }{4}
>$float(%)
 %image% TugasAplikom6_Ridwan25030630091-093.png
% // latex: \int_{0.0}^{1.0}{\sqrt{4.0\,x^2+1.0}\;dx}=1.478942857544598
% Penjelasan: hasil eksaknya (asinh(2)+2 akar(5))/4, sekitar 1,4789.
% 
% ** Panjang kurva
% 
% Prinsipnya: kurva dipotong jadi potongan kecil ds yang dianggap garis
% lurus, lalu dijumlahkan dari A ke B.
% 
% latex: ds=\sqrt{dx^2+dy^2},\quad S=\int ds. latex: S=\int_a^b\sqrt{1+(f'(x))^2}\,dx,\qquad S=\int_{t_0}^{t_1}\sqrt{x'(t)^2+y'(t)^2}\,dt.
% %image% TugasAplikom6_Ridwan25030630091-094.png
% // latex: ds=\sqrt{dx^2+dy^2},\quad S=\int ds. latex: S=\int_a^b\sqrt{1+(f'(x))^2}\,dx,\qquad S=\int_{t_0}^{t_1}\sqrt{x'(t)^2+y'(t)^2}\,dt.
% 
% Contoh, parabola y = x^2 dari -1 sampai 1:
>$showev('integrate(sqrt(1+diff(x^2,x)^2),x,-1,1))
 %image% TugasAplikom6_Ridwan25030630091-095.png
% // latex: \int_{-1}^{1}{\sqrt{4\,x^2+1}\;dx}=\frac{{\rm asinh}\; 2+2\,\sqrt{5  }}{2}
>$float(%)
 %image% TugasAplikom6_Ridwan25030630091-096.png
% // latex: \int_{-1.0}^{1.0}{\sqrt{4.0\,x^2+1.0}\;dx}=2.957885715089195
% Eksaknya sekitar 2,9579.
% 
% Supaya bisa dipakai untuk kurva apa saja, saya buat fungsi umum.
% Bedanya dengan cara di atas, fungsi ini menjumlahkan panjang ruas
% garis kecil di sepanjang kurva (2000 titik), jadi tidak perlu Maxima.
>function panjangkurva (fx$,fy$,a,b,n=2000) ...
$  tt=linspace(a,b,n);
$  X=fx$(tt); Y=fy$(tt);
$  i=1:n-1;
$  return sum(sqrt((X[i+1]-X[i])^2+(Y[i+1]-Y[i])^2));
$endfunction
>panjangkurva("x","x^2",-1,1)
2.95565039242
>panjangkurva("x*cos(x)","x*sin(x)",0,2*pi)
21.2363001506
% Hasilnya 2,9579 (cocok dengan cara eksak) dan 21,2563 (spiral
% Archimedes).
% 
% ** Keliling lingkaran dan keliling elips
% 
% Tugas dosen: buktikan keliling lingkaran 2 pi R.
% 
% latex: x=R\cos t,\; y=R\sin t,\; 0\le t\le 2\pi.
% %image% TugasAplikom6_Ridwan25030630091-097.png
% // latex: x=R\cos t,\; y=R\sin t,\; 0\le t\le 2\pi.
>&assume(R>0);
>fxl &= R*cos(t); fyl &= R*sin(t);
>dsl &= radcan(sqrt(diff(fxl,t)^2+diff(fyl,t)^2)); $dsl
 %image% TugasAplikom6_Ridwan25030630091-098.png
% // latex: \sqrt{\sin ^2t+\cos ^2t}\,R
>$showev('integrate(dsl,t,0,2*pi))
 %image% TugasAplikom6_Ridwan25030630091-099.png
% // latex: \left(\int_{0}^{2\,\pi}{\sqrt{\sin ^2t+\cos ^2t}\;dt}\right)\,R=2\,  \pi\,R
% Elemen panjangnya ds = R dt (karena sin^2 + cos^2 = 1), jadi
% kelilingnya R kali 2 pi = 2 pi R. Terbukti.
% 
% Elips x = 3 cos t, y = 2 sin t:
% 
% latex: K=\int_0^{2\pi}\sqrt{9\sin^2t+4\cos^2t}\,dt
% %image% TugasAplikom6_Ridwan25030630091-100.png
% // latex: K=\int_0^{2\pi}\sqrt{9\sin^2t+4\cos^2t}\,dt
>integrate("sqrt(9*sin(x)^2+4*cos(x)^2)",0,2*pi)
15.8654395893
>pi*(3*(3+2)-sqrt((3*3+2)*(3+3*2)))
15.8654375756
% Integral ini tidak punya hasil eksak sederhana, jadi dihitung numerik:
% sekitar 15,865. Baris kedua rumus hampiran Ramanujan memberi angka
% yang sangat dekat. Jadi tidak ada rumus keliling elips yang "rapi"
% seperti 2 pi R pada lingkaran.
% 
% * Kurva polar dan sikloid
% ** contoh
% 
% latex: r(t)=1+\frac{\sin 3t}{2},\; 0\le t\le 2\pi.
% %image% TugasAplikom6_Ridwan25030630091-101.png
% // latex: r(t)=1+\frac{\sin 3t}{2},\; 0\le t\le 2\pi.
>function rp(t) &= 1+sin(3*t)/2

                             sin(3 t)
                             -------- + 1
                                2

>function fx2(t) &= rp(t)*cos(t)

                                sin(3 t)
                        cos(t) (-------- + 1)
                                   2

>function fy2(t) &= rp(t)*sin(t)

                                sin(3 t)
                        sin(t) (-------- + 1)
                                   2

>function ds(t) &= trigreduce(radcan(sqrt(diff(fx2(t),t)^2+diff(fy2(t),t)^2)))

                  sqrt(4 cos(6 t) + 4 sin(3 t) + 9)
                  ---------------------------------
                                  2

>integrate("ds(x)",0,2*pi)
9.0749467823
>tt=linspace(0,2pi,1000); px=rp(tt)*cos(tt); py=rp(tt)*sin(tt); plot2d(px,py,>filled,fillcolor=red,style="/",r=1.5):
 %image% TugasAplikom6_Ridwan25030630091-102.png
% Maxima gagal menghitung integral ds secara eksak, jadi dipakai
% integrate numerik: panjangnya 9,0749. Gambarnya mawar berdaun tiga.
% 
% Sikloid: lintasan satu titik di tepi roda yang menggelinding.
% 
% latex: x=R(t-\sin t),\; y=R(1-\cos t),\quad R=1.
% %image% TugasAplikom6_Ridwan25030630091-103.png
% // latex: x=R(t-\sin t),\; y=R(1-\cos t),\quad R=1.
>ex &= x-sin(x); ey &= 1-cos(x);
>dss &= trigsimp(radcan(sqrt(diff(ex,x)^2+diff(ey,x)^2))); $dss
 %image% TugasAplikom6_Ridwan25030630091-104.png
