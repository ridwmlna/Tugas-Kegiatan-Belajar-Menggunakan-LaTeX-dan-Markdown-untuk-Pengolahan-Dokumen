>$showev('integrate(2*x*cos(x^2),x))
 %image% TugasAplikom6_Ridwan25030630091-063.png
% // latex: 2\,\int {x\,\cos x^2}{\;dx}=\sin x^2
>$showev('diff(sin(x^2),x))
 %image% TugasAplikom6_Ridwan25030630091-064.png
% // latex: \frac{d}{d\,x}\,\sin x^2=2\,x\,\cos x^2
% Penjelasan: u = x^2, du = 2x dx, jadi integralnya cos u du = sin u + C
% = sin(x^2) + C. Baris kedua mengecek: turunannya kembali ke 2x
% cos(x^2).
% 
% Soal 3 (parsial):
% 
% latex: \int x e^{x}\,dx
% %image% TugasAplikom6_Ridwan25030630091-065.png
% // latex: \int x e^{x}\,dx
>$showev('integrate(x*exp(x),x))
 %image% TugasAplikom6_Ridwan25030630091-066.png
% // latex: \int {x\,e^{x}}{\;dx}=\left(x-1\right)\,e^{x}
>$showev('diff((x-1)*exp(x),x))
 %image% TugasAplikom6_Ridwan25030630091-067.png
% // latex: \frac{d}{d\,x}\,\left(\left(x-1\right)\,e^{x}\right)=\left(x-1  \right)\,e^{x}+e^{x}
% Penjelasan: u = x, dv = e^x dx, rumus latex: \int u\,dv=uv-\int v\,du
% memberi x e^x - e^x = (x-1)e^x + C. Turunannya kembali ke x e^x.
% 
% Soal 4 (trigonometri):
% 
% latex: \int \sin^3 x\,dx
% %image% TugasAplikom6_Ridwan25030630091-068.png
% // latex: \int \sin^3 x\,dx
>$showev('integrate(sin(x)^3,x))
 %image% TugasAplikom6_Ridwan25030630091-069.png
% // latex: \int {\sin ^3x}{\;dx}=\frac{\cos ^3x}{3}-\cos x
% Penjelasan: sin^3 x = sin x (1 - cos^2 x). Dengan u = cos x, hasilnya
% -cos x + (cos^3 x)/3 + C, sama dengan keluaran Maxima.
% 
% Soal 5 (pecahan parsial):
% 
% latex: \int \frac{1}{x^2-1}\,dx
% %image% TugasAplikom6_Ridwan25030630091-070.png
% // latex: \int \frac{1}{x^2-1}\,dx
>$partfrac(1/(x^2-1),x)
 %image% TugasAplikom6_Ridwan25030630091-071.png
% // latex: \frac{1}{2\,\left(x-1\right)}-\frac{1}{2\,\left(x+1\right)}
>$showev('integrate(1/(x^2-1),x))
 %image% TugasAplikom6_Ridwan25030630091-072.png
% // latex: \int {\frac{1}{x^2-1}}{\;dx}=\frac{\log \left(x-1\right)}{2}-\frac{  \log \left(x+1\right)}{2}
% Penjelasan: 1/(x^2-1) dipecah jadi (1/2)/(x-1) - (1/2)/(x+1), lalu
% tiap bagian diintegralkan: (1/2) ln|x-1| - (1/2) ln|x+1| + C.
% 
% * 5. Integral Tentu dan Aplikasinya
% 
% Integral tentu adalah luas bertanda di bawah kurva, didefinisikan
% sebagai limit jumlah Riemann:
%% latex: \int_a^b f(x)\,dx=\lim_{n\to\infty}\sum_{i=1}^n f(x_i^*)\Delta x.
% %image% TugasAplikom6_Ridwan25030630091-073.png
% // latex: \int_a^b f(x)\,dx=\lim_{n\to\infty}\sum_{i=1}^n f(x_i^*)\Delta x.
% 
% Teorema Dasar Kalkulus (TDK): 
% 
% latex: \int_a^b f(x)\,dx=F(b)-F(a),\quad F'=f.
% %image% TugasAplikom6_Ridwan25030630091-074.png
% // latex: \int_a^b f(x)\,dx=F(b)-F(a),\quad F'=f.
% 
>$showev('integrate(sin(x),x,0,pi))
 %image% TugasAplikom6_Ridwan25030630091-075.png
% // latex: \int_{0}^{\pi}{\sin x\;dx}=2
>$showev('integrate(x*exp(-x),x,0,1))
