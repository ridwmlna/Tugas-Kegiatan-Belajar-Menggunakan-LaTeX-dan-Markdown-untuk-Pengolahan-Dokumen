                            7     5     3
                           x     x     x
                        - ---- + --- - -- + x
                          5040   120   6

>plot2d(["sin(x)","t3(x)","t7(x)"],-pi,pi,color=[black,red,blue]):
 %image% TugasAplikom6_Ridwan25030630091-132.png
% Kalau titik ekspansi a = 0, namanya deret Maclaurin: sin x = x - x^3/6
% + x^5/120 - x^7/5040 + ... Makin banyak suku, kurva hampiran (merah
% lalu biru) makin menempel pada kurva sin x di sekitar x=0.
% 
% * 7. Fungsi Multivariabel
% 
% Fungsi dua variabel z = f(x,y) memberi satu nilai untuk setiap
% pasangan (x,y); grafiknya berupa permukaan di ruang 3D. Turunan
% parsial adalah turunan terhadap satu variabel dengan variabel lain
% dianggap konstan: 
% 
% latex: f_x=\frac{\partial f}{\partial x},\quad f_y=\frac{\partial f}{\partial y},\quad df=f_x\,dx+f_y\,dy.
% %image% TugasAplikom6_Ridwan25030630091-133.png
% // latex: f_x=\frac{\partial f}{\partial x},\quad f_y=\frac{\partial f}{\partial y},\quad df=f_x\,dx+f_y\,dy.
% 
% Integral lipat dua menghitung volume di bawah permukaan:
% 
% latex: V=\iint_R f(x,y)\,dA.
% %image% TugasAplikom6_Ridwan25030630091-134.png
% // latex: V=\iint_R f(x,y)\,dA.
% 
% ** Grafik permukaan
% 
>plot3d("x^2+y^2",r=2,>hue,>spectral,>contour):
 %image% TugasAplikom6_Ridwan25030630091-135.png
>plot3d("x^2-y^2",r=2,>hue,>spectral):
 %image% TugasAplikom6_Ridwan25030630091-136.png
% Yang pertama paraboloida berbentuk mangkuk, garis konturnya lingkaran
% sepusat. Yang kedua pelana: naik ke satu arah dan turun ke arah lain,
% titik tengahnya (0,0) adalah titik pelana.
% 
% ** Latihan 7
%% Soal 1:
%% turunan parsial pertama dan kedua.
% 
% latex: f(x,y)=x^2y+y^3
% %image% TugasAplikom6_Ridwan25030630091-137.png
% // latex: f(x,y)=x^2y+y^3
>function fm(x,y) &= x^2*y+y^3

                               3    2
                              y  + x  y

>fmx &= diff(fm(x,y),x); fmy &= diff(fm(x,y),y);
>$'f_x=fmx, $'f_y=fmy
 %image% TugasAplikom6_Ridwan25030630091-138.png
% // latex: {\it f\_\_x}=2\,x\,y
 %image% TugasAplikom6_Ridwan25030630091-139.png
% // latex: {\it f\_\_y}=3\,y^2+x^2
>fmxx &= diff(fm(x,y),x,2); fmyy &= diff(fm(x,y),y,2); fmxy &= diff(diff(fm(x,y),x),y);
>$'f_xx=fmxx, $'f_yy=fmyy, $'f_xy=fmxy
 %image% TugasAplikom6_Ridwan25030630091-140.png
% // latex: {\it f\_\_xx}=2\,y
 %image% TugasAplikom6_Ridwan25030630091-141.png
% // latex: {\it f\_\_yy}=6\,y
 %image% TugasAplikom6_Ridwan25030630091-142.png
% // latex: {\it f\_\_xy}=2\,x
>&subst([x=1,y=2],fmx), &subst([x=1,y=2],fmy)

                                  4


                                  13

% Penjelasan: fx = 2xy, fy = x^2+3y^2, fxx = 2y, fyy = 6y, fxy = 2x. Di
% (1,2) nilai fx = 4 dan fy = 13, jadi gradiennya (4,13), arah naik
% paling cepat.
% 
% Soal 2:
%% diferensial total.
%% latex: df=f_x\,dx+f_y\,dy=2xy\,dx+(x^2+3y^2)\,dy
% %image% TugasAplikom6_Ridwan25030630091-143.png
% // latex: df=f_x\,dx+f_y\,dy=2xy\,dx+(x^2+3y^2)\,dy
>dz &= fmx*dx+fmy*dy; $'df=dz
 %image% TugasAplikom6_Ridwan25030630091-144.png
% // latex: {\it df}={\it dy}\,\left(3\,y^2+x^2\right)+2\,{\it dx}\,x\,y
>&subst([x=1,y=2,dx=0.1,dy=-0.05],dz)

                                - 0.25

>fm(1.1,1.95)-fm(1,2)
-0.225625
% Penjelasan: dari (1,2) bergeser dx = 0,1 dan dy = -0,05, hampiran
% perubahan fungsinya 4(0,1)+13(-0,05) = -0,25. Perubahan sebenarnya
% -0,2256. Agak meleset karena pergeserannya belum terlalu kecil; makin
% kecil dx dan dy, makin dekat.
% 
% 
% Soal 3:
%% makna hasilnya. Karena x^2+y^2 tidak pernah negatif, 10/3 adalah
% volume benda di bawah permukaan z = x^2+y^2 dan di atas persegi
% panjang 0<=x<=2, 0<=y<=1 (gambar terakhir).
% 
% Tambahan, titik kritis:
%% latex: f(x,y)=x^2+y^2-2x-4y
% %image% TugasAplikom6_Ridwan25030630091-145.png
% // latex: f(x,y)=x^2+y^2-2x-4y
>function fc(x,y) &= x^2+y^2-2*x-4*y

                          2          2
                         y  - 4 y + x  - 2 x

>&solve([diff(fc(x,y),x)=0,diff(fc(x,y),y)=0],[x,y])

                           [[x = 1, y = 2]]

>fc(1,2)
-5
>plot3d("x^2+y^2-2*x-4*y",a=-1,b=3,c=0,d=4,>hue):
 %image% TugasAplikom6_Ridwan25030630091-146.png
>  
% fx = 2x-2 = 0 dan fy = 2y-4 = 0 memberi titik (1,2) dengan nilai -5.
% Dari grafik (mangkuk yang digeser) titik itu adalah minimum.
% 
% * Kesimpulan
% 
% Dari tugas ini saya melihat EMT bisa dipakai untuk hampir semua
% materi kalkulus, dan ada pola kapan harus pakai simbolik atau
% numerik:
% 
% 1. Fungsi: fungsi numerik (:=) cocok untuk nilai dan grafik, fungsi
%    simbolik (&=) untuk rumus dan komposisi. Domain harus dicek, kalau
%    tidak EMT memberi error.
% 2. Limit: bentuk 0/0 bisa punya limit, dan limit kiri-kanan yang
%    beda berarti limit tidak ada (|x-1|/(x-1), sin(1/x)).
% 3. Turunan: dari definisi limit didapat rumus x^n, sin x, ln x, x^x,
%    dan arcsin x. Titik stasioner dicari dari turunan = 0, lalu
%    dicek dengan turunan kedua.
% 4. Integral tak tentu: tiap hasil bisa dicek dengan menurunkannya
%    kembali. Beberapa integral (e^(-x^2)) hanya bisa dinyatakan
%    dengan fungsi khusus erf.
% 5. Integral tentu: dipakai untuk luas (1/6), volume benda putar
%    (8 pi), dan panjang kurva. Panjang kurva bisa eksak (lingkaran
%    2 pi R, sikloid 8) atau harus numerik (elips 15,865, mawar
%    polar 9,075). Kurvatur lingkaran jari-jari R adalah 1/R.
% 6. Barisan dan deret: ada barisan yang menuju bilangan tertentu
%    (pecahan emas, akar 2, 1 untuk akar berulang), deret geometri
%    menuju a/(1-r), dan deret Taylor memberi hampiran fungsi.
% 7. Fungsi multivariabel: turunan parsial, diferensial total, dan
%    integral lipat dua (volume 10/3) memperluas konsep yang sama ke
%    dua variabel.
% 
% Hal yang perlu diingat: hasil simbolik berguna untuk bentuk eksak,
% tetapi kalau Maxima gagal (misalnya panjang elips) hasil numerik
% tetap bisa dipakai. Grafik hanya pendukung untuk melihat pola,
% bukan pembuktian. Beberapa sintaks Maxima juga bergantung pada
% versi EMT dan asumsi variabelnya.
