>function hiter(f$,x0) ...
$  x=x0; n=0;
$  repeat
$    y=f$(x); n=n+1;
$    if abs(y-x)<1e-10 then break; endif;
$    if n>1000 then break; endif;
$    x=y;
$  end;
$  return n;
$endfunction
