% 
% * 2. Limit Fungsi
% 
% Limit f(x) saat x mendekati a bernilai L kalau f(x) bisa dibuat
% sedekat mungkin ke L dengan memilih x cukup dekat ke a (x tidak harus
% sama dengan a). Limit ada kalau limit kiri sama dengan limit kanan:
% 
% latex: \lim_{x\to a}f(x)=L \iff \lim_{x\to a^-}f(x)=\lim_{x\to a^+}f(x)=L.
% %image% TugasAplikom6_Ridwan25030630091-012.png
% // latex: \lim_{x\to a}f(x)=L \iff \lim_{x\to a^-}f(x)=\lim_{x\to a^+}f(x)=L.
% 
% Di EMT limit dihitung Maxima. Limit kiri memakai minus, limit kanan
% plus, tak hingga ditulis inf dan minf. Hasil "ind" artinya tak tentu
% (limit tidak ada).
% 
% ** Contoh:
% 
% Fungsi yang berlubang tetapi limitnya ada:
% 
% latex: \lim_{x\to 3}\frac{x^3-13x^2+51x-63}{x^3-4x^2-3x+18}
% %image% TugasAplikom6_Ridwan25030630091-013.png
% // latex: \lim_{x\to 3}\frac{x^3-13x^2+51x-63}{x^3-4x^2-3x+18}
>$showev('limit((x^3-13*x^2+51*x-63)/(x^3-4*x^2-3*x+18),x,3))
 %image% TugasAplikom6_Ridwan25030630091-014.png
% // latex: \lim_{x\rightarrow 3}{\frac{x^3-13\,x^2+51\,x-63}{x^3-4\,x^2-3\,x+  18}}=-\frac{4}{5}
>aspect(1.5); plot2d("(x^3-13*x^2+51*x-63)/(x^3-4*x^2-3*x+18)",0,4); plot2d(3,-4/5,>points,style="ow",>add):
 %image% TugasAplikom6_Ridwan25030630091-015.png
% Fungsinya tidak terdefinisi di x=3 (lingkaran kosong di grafik), tapi
% kurvanya mendekati -4/5 dari kedua sisi, jadi limitnya -4/5.
% 
% Tiga limit berbentuk 0/0 yang hasilnya ada:
>$showev('limit(2*x*sin(x)/(1-cos(x)),x,0))
 %image% TugasAplikom6_Ridwan25030630091-016.png
% // latex: 2\,\left(\lim_{x\rightarrow 0}{\frac{x\,\sin x}{1-\cos x}}\right)=4
>$showev('limit(cot(7*h)/cot(5*h),h,0))
 %image% TugasAplikom6_Ridwan25030630091-017.png
% // latex: \lim_{h\rightarrow 0}{\frac{\cot \left(7\,h\right)}{\cot \left(5\,h  \right)}}=\frac{5}{7}
>$showev('limit(sin(x)/x,x,0))
 %image% TugasAplikom6_Ridwan25030630091-018.png
% // latex: \lim_{x\rightarrow 0}{\frac{\sin x}{x}}=1
% Hasilnya 4, 5/7, dan 1. Bentuk 0/0 tidak otomatis berarti limitnya
% tidak ada, tergantung fungsinya.
% 
% Limit di tak hingga dan bilangan e:
>$showev('limit(sqrt(x^2+x)-x,x,inf))
 %image% TugasAplikom6_Ridwan25030630091-019.png
% // latex: \lim_{x\rightarrow \infty }{\sqrt{x^2+x}-x}=\frac{1}{2}
>$showev('limit((1+1/x)^x,x,inf))
 %image% TugasAplikom6_Ridwan25030630091-020.png
% // latex: \lim_{x\rightarrow \infty }{\left(\frac{1}{x}+1\right)^{x}}=e
>plot2d("(1+1/x)^x",0,1000):
 %image% TugasAplikom6_Ridwan25030630091-021.png
% Hasil pertama 1/2 dan kedua e. Walaupun 1/x menuju 0 (basisnya
% menuju 1), hasilnya bukan 1 karena pangkatnya ikut membesar. Grafik
% mendatar di sekitar 2,718.
% 
% Limit yang tidak ada karena berosilasi:
>$showev('limit(sin(1/x),x,0))
 %image% TugasAplikom6_Ridwan25030630091-022.png
% // latex: \lim_{x\rightarrow 0}{\sin \left(\frac{1}{x}\right)}={\it ind}
>$showev('limit(sin(1/x),x,inf))
 %image% TugasAplikom6_Ridwan25030630091-023.png
% // latex: \lim_{x\rightarrow \infty }{\sin \left(\frac{1}{x}\right)}=0
>plot2d("sin(1/x)",-5,5):
 %image% TugasAplikom6_Ridwan25030630091-024.png
% Di x=0 hasilnya ind: grafiknya bergoyang makin rapat antara -1 dan 1
% sehingga tidak mendekati satu nilai. Untuk x menuju tak hingga, 1/x
% menuju 0 jadi sin(1/x) menuju 0.
% 
% ** Latihan 2: lima limit
% 
% Soal 1:
%% latex: \lim_{x\to 3}\frac{x^2-9}{2x^2-5x-3}
% %image% TugasAplikom6_Ridwan25030630091-025.png
% // latex: \lim_{x\to 3}\frac{x^2-9}{2x^2-5x-3}
>$showev('limit((x^2-9)/(2*x^2-5*x-3),x,3))
 %image% TugasAplikom6_Ridwan25030630091-026.png
% // latex: \lim_{x\rightarrow 3}{\frac{x^2-9}{2\,x^2-5\,x-3}}=\frac{6}{7}
>plot2d("(x^2-9)/(2*x^2-5*x-3)",2,4); plot2d(3,6/7,>points,style="ow",>add):
 %image% TugasAplikom6_Ridwan25030630091-027.png
% Penjelasan: difaktorkan jadi (x-3)(x+3) / ((x-3)(2x+1)). Faktor (x-3)
% dicoret, sisa (x+3)/(2x+1) yang bernilai 6/7 di x=3. Grafiknya
% berlubang di (3, 6/7).
% 
% Soal 2:
%% latex: \lim_{x\to 1^-}\frac{|x-1|}{x-1}\quad\text{dan}\quad \lim_{x\to 1^+}\frac{|x-1|}{x-1}
% %image% TugasAplikom6_Ridwan25030630091-028.png
% // latex: \lim_{x\to 1^-}\frac{|x-1|}{x-1}\quad\text{dan}\quad \lim_{x\to 1^+}\frac{|x-1|}{x-1}
>$showev('limit(abs(x-1)/(x-1),x,1,minus))
 %image% TugasAplikom6_Ridwan25030630091-029.png
% // latex: \lim_{x\uparrow 1}{\frac{\left| x-1\right| }{x-1}}=-1
>$showev('limit(abs(x-1)/(x-1),x,1,plus))
 %image% TugasAplikom6_Ridwan25030630091-030.png
% // latex: \lim_{x\downarrow 1}{\frac{\left| x-1\right| }{x-1}}=1
% Penjelasan: di kiri 1, |x-1| = -(x-1) sehingga hasilnya -1. Di kanan 1
% hasilnya +1. Karena beda, limit dua sisi di x=1 tidak ada.
% 
% Soal 3:
%% latex: \lim_{x\to 0}\frac{1-\cos x}{x^2}
% %image% TugasAplikom6_Ridwan25030630091-031.png
% // latex: \lim_{x\to 0}\frac{1-\cos x}{x^2}
>$showev('limit((1-cos(x))/x^2,x,0))
 %image% TugasAplikom6_Ridwan25030630091-032.png
% // latex: \lim_{x\rightarrow 0}{\frac{1-\cos x}{x^2}}=\frac{1}{2}
% Penjelasan: hasilnya 1/2. Lewat kali sekawan, 1-cos x = sin^2 x /
% (1+cos x), jadi bentuknya (sin x / x)^2 / (1+cos x) yang menuju 1/2.
% 
% Soal 4:
%% latex: \lim_{x\to\infty}\left(\sqrt{x^2+x}-x\right)
% %image% TugasAplikom6_Ridwan25030630091-033.png
% // latex: \lim_{x\to\infty}\left(\sqrt{x^2+x}-x\right)
>$showev('limit(sqrt(x^2+x)-x,x,inf))
 %image% TugasAplikom6_Ridwan25030630091-034.png
% // latex: \lim_{x\rightarrow \infty }{\sqrt{x^2+x}-x}=\frac{1}{2}
% Penjelasan: dikali sekawan jadi x/(sqrt(x^2+x)+x). Dibagi x, dan saat
% x besar hasilnya 1/(1+1) = 1/2.
% 
% Soal 5: gambar salah satu fungsi dan hubungkan dengan limitnya.
>plot2d("sqrt(x^2+x)-x",1,100); plot2d("0.5+0*x",1,100,>add,color=red):
 %image% TugasAplikom6_Ridwan25030630091-035.png
% Penjelasan: kurva biru naik lalu hampir menempel pada garis merah y =
% 0,5. Itu arti limit tak hingga: nilai fungsi makin dekat ke 0,5 tapi
% tidak harus menyentuhnya. Catatan: grafik hanya membantu melihat,
% bukan pembuktian.
% 
% * 3. Turunan Fungsi
% 
% Turunan didefinisikan lewat limit:
% 
% latex: f'(x)=\lim_{h\to 0}\frac{f(x+h)-f(x)}{h}.
% %image% TugasAplikom6_Ridwan25030630091-036.png
% // latex: f'(x)=\lim_{h\to 0}\frac{f(x+h)-f(x)}{h}.
% 
% Artinya kemiringan garis singgung di titik x, atau laju perubahan
% sesaat. Aturan yang dipakai: jumlah, hasil kali (fg)'=f'g+fg', hasil
% bagi, dan rantai (f(g))'=f'(g)g'.
% 
% ** Turunan dari definisi
%% ** contoh:
% 
>$showev('limit(((x+h)^n-x^n)/h,h,0))
 %image% TugasAplikom6_Ridwan25030630091-037.png
% // latex: \lim_{h\rightarrow 0}{\frac{\left(x+h\right)^{n}-x^{n}}{h}}=n\,x^{n  -1}
% Hasilnya n x^(n-1). Alasannya: (x+h)^n diuraikan dengan binomial,
% dikurangi x^n lalu dibagi h, sisa n x^(n-1) ditambah suku-suku yang
% masih memuat h, dan suku itu hilang saat h menuju 0.
>$showev('limit((sin(x+h)-sin(x))/h,h,0))
 %image% TugasAplikom6_Ridwan25030630091-038.png
% // latex: \lim_{h\rightarrow 0}{\frac{\sin \left(x+h\right)-\sin x}{h}}=\cos   x
% Hasilnya cos x. sin(x+h) = sin x cos h + cos x sin h, jadi hasil
% baginya sin x (cos h - 1)/h + cos x (sin h)/h. Saat h menuju 0 suku
% pertama menuju 0 dan suku kedua menuju cos x.
>$showev('limit((log(x+h)-log(x))/h,h,0))
 %image% TugasAplikom6_Ridwan25030630091-039.png
% // latex: \lim_{h\rightarrow 0}{\frac{\log \left(x+h\right)-\log x}{h}}=  \frac{1}{x}
% Hasilnya 1/x. (ln(x+h)-ln x)/h = (1/x) ln((1+h/x)^(x/h)), dan bentuk
% di dalam ln menuju e, jadi hasilnya (1/x) ln e = 1/x.
% 
% Untuk x^x, Maxima perlu tahu bahwa x positif:
>function fx(x) &= x^x

                                   x
                                  x

>&assume(x>0); $showev('limit((fx(x+h)-fx(x))/h,h,0))
 %image% TugasAplikom6_Ridwan25030630091-040.png
% // latex: \lim_{h\rightarrow 0}{\frac{\left(x+h\right)^{x+h}-x^{x}}{h}}=x^{x}  \,\left(\log x+1\right)
>&forget(x>0)

                               [x > 0]

% Hasilnya x^x (ln x + 1). Cara manualnya: y = x^x, ln y = x ln x,
% turunkan: y'/y = ln x + 1, jadi y' = x^x (ln x + 1).
>$showev('limit((asin(x+h)-asin(x))/h,h,0))
 %image% TugasAplikom6_Ridwan25030630091-041.png
% // latex: \lim_{h\rightarrow 0}{\frac{\arcsin \left(x+h\right)-\arcsin x}{h}}=  \frac{1}{\sqrt{1-x^2}}
% Hasilnya 1/akar(1-x^2). Manualnya: y = arcsin x berarti sin y = x.
% Turunkan: cos y . y' = 1, dan cos y = akar(1-x^2) karena cos y positif
% di (-pi/2, pi/2).
% 
% ** diff dan diffc
% 
>function fz(x) &= sin(3*x^5+7)^2

                               2    5
                            sin (3 x  + 7)

>diff("fz(x)",3), diffc("fz(x)",3)
1198.32948904
1198.72863721
>$showev('diff(fz(x),x))
 %image% TugasAplikom6_Ridwan25030630091-042.png
% // latex: \frac{d}{d\,x}\,\sin ^2\left(3\,x^5+7\right)=30\,x^4\,\cos \left(3  \,x^5+7\right)\,\sin \left(3\,x^5+7\right)
% Dari rumus turunannya, 30 x^4 cos(3x^5+7) sin(3x^5+7), nilai eksak di
% x=3 adalah 1198,7286. diffc memberi 1198,7286 (pas), sedangkan diff
% memberi 1198,329 (meleset sedikit). Dugaan saya, diff memakai selisih
% biasa sehingga kurang teliti kalau fungsinya berubah sangat cepat
% seperti ini. Itu dugaan, belum saya cek ke dokumentasi EMT.
% 
% Titik tempat turunan bernilai nol:
>function f1(x) &= 5*cos(2*x)-2*x*sin(2*x)

                      5 cos(2 x) - 2 x sin(2 x)

>function df1(x) &= diff(f1(x),x)

                     - 12 sin(2 x) - 4 x cos(2 x)

>xp=solve("df1(x)",1,2,0)
1.35822987384
>df1(xp), f1(xp)
0
-5.67530133759
>plot2d(["f1(x)","df1(x)"],0,2*pi,color=[blue,red]):
 %image% TugasAplikom6_Ridwan25030630091-043.png
% xp = 1,358 adalah titik tempat f1'(xp) = 0, dan nilai f1 di situ
% sekitar -5,675 (lembah kurva biru). Di setiap puncak atau lembah kurva
% biru, kurva merah (turunannya) memotong sumbu x.
% 
% ** Latihan 3
% 
% Soal 1 (dari definisi):
%% latex: f(x)=x^3-3x+2
% %image% TugasAplikom6_Ridwan25030630091-044.png
% // latex: f(x)=x^3-3x+2
>$showev('limit(((x+h)^3-3*(x+h)+2-(x^3-3*x+2))/h,h,0))
 %image% TugasAplikom6_Ridwan25030630091-045.png
% // latex: \lim_{h\rightarrow 0}{\frac{\left(x+h\right)^3-x^3-3\,\left(x+h  \right)+3\,x}{h}}=3\,x^2-3
