% 
% * 6. Barisan dan Deret
% 
% Barisan adalah daftar bilangan berurutan, deret adalah jumlah suku-
% sukunya. Barisan konvergen kalau limit a_n ada dan berhingga, selain
% itu divergen.
% 
% latex: S_n=\sum_{k=1}^n a_k,\qquad \sum_{k=1}^\infty a_k=\lim_{n\to\infty}S_n. latex: \sum_{k=0}^{n-1}ar^k=\frac{a(1-r^n)}{1-r},\qquad \sum_{k=0}^\infty ar^k=\frac{a}{1-r}\ (|r|<1).
% %image% TugasAplikom6_Ridwan25030630091-116.png
% // latex: S_n=\sum_{k=1}^n a_k,\qquad \sum_{k=1}^\infty a_k=\lim_{n\to\infty}S_n. latex: \sum_{k=0}^{n-1}ar^k=\frac{a(1-r^n)}{1-r},\qquad \sum_{k=0}^\infty ar^k=\frac{a}{1-r}\ (|r|<1).
% 
