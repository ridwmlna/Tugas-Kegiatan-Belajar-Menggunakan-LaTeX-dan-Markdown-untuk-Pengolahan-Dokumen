% 
% latex: S_6=\sum_{k=0}^{5}\left(\tfrac12\right)^k=\frac{1-(1/2)^6}{1-1/2}=\frac{63}{32}
% %image% TugasAplikom6_Ridwan25030630091-124.png
% // latex: S_6=\sum_{k=0}^{5}\left(\tfrac12\right)^k=\frac{1-(1/2)^6}{1-1/2}=\frac{63}{32}
>$'sum((1/2)^k,k,0,5)=ev(sum((1/2)^k,k,0,5),simpsum=true)
